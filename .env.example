# ---- Supabase -------------------------------------------------------------
# Projecto local (supabase start) ou projecto remoto.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Apenas server-side. Nunca prefixar com NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# ---- Aplicação ------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Sal para o hash efémero de IP no rate limiting.
# Gerar com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ANALYTICS_IP_SALT=

# ---- Opcional -------------------------------------------------------------
# Rate limiting distribuído (recomendado em produção)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Monitorização de erros
SENTRY_DSN=

# ---- Scripts (não usados em runtime) -------------------------------------
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=
